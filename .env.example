# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real secrets.

# Configuration SMTP pour l'envoi du digest par e-mail (Gmail par exemple)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Mot de passe d'application généré sur ton compte Google (pas ton mot de passe normal)
SMTP_PASSWORD=your_app_password
# Adresse qui reçoit le digest (peut être la même que SMTP_USER)
EMAIL_RECIPIENT=your_email@gmail.com

# Mistral AI (LLM hébergé via api.mistral.ai) — génère une clé sur
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT=120
