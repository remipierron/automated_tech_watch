# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real secrets.

# Configuration SMTP pour l'envoi du digest par e-mail (Gmail par exemple)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Mot de passe d'application généré sur ton compte Google (pas ton mot de passe normal)
SMTP_PASSWORD=your_app_password
# Adresse qui reçoit le digest (peut être la même que SMTP_USER)
EMAIL_RECIPIENT=your_email@gmail.com

# Ollama (LLM local) — inutile de changer OLLAMA_BASE_URL avec Docker Compose,
# le service "ollama" y répond déjà à ce nom sur ce port.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# Sur du matériel CPU-only limité (ex. Raspberry Pi, pas de GPU), "qwen2.5:3b"
# (~2 Go) est un bon compromis qualité/vitesse/espace disque. Autres modèles
# légers possibles (docker compose pull automatiquement le modèle choisi au
# démarrage) :
#   OLLAMA_MODEL=phi3:mini      # très rapide, réponses plus sommaires (~2.2 Go)
#   OLLAMA_MODEL=qwen2.5:1.5b   # encore plus léger (~1 Go), qualité en baisse
#   OLLAMA_MODEL=mistral        # modèle d'origine (7B, ~4.4 Go), plus lent sur CPU
# Pense aussi à augmenter OLLAMA_TIMEOUT si l'inférence CPU dépasse 120s.
